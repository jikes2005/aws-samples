{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAgentCodeZip",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::agentcore-poc-code-123456789012/agentcore_poc_agent/deployment_package.zip"
    },
    {
      "Sid": "DecryptAgentCodeZip",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:ca-central-1:123456789012:key/11111111-2222-3333-4444-555555555555",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.ca-central-1.amazonaws.com"
        },
        "StringLike": {
          "kms:EncryptionContext:aws:s3:arn": "arn:aws:s3:::agentcore-poc-code-123456789012*"
        }
      }
    }
  ]
}
